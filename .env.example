# Скопируй в .env и заполни. Файл .env в git не попадает.
# Без TURSO_DATABASE_URL сервер работает с локальным файлом data/noventis.db.
TURSO_DATABASE_URL=libsql://noventis-<логин>.turso.io
TURSO_AUTH_TOKEN=
# Длинный случайный секрет, тот же — в Cloudflare Pages. На своём компьютере оставь пустым.
PROXY_KEY=
NODE_ENV=production
# Вакансии hh.uz на странице /jobs. Зарегистрируй приложение на https://dev.hh.ru и впиши Client ID и Client Secret —
# сервер сам получит токен. Без них страница даёт ссылки на поиск по hh.uz, OLX и LinkedIn.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
